DEF t_ld TimeSensor {
  cycleInterval 4
  loop TRUE
}

DEF ld_rot OrientationInterpolator {
  key [ 0, 0.5, 1 ]
  keyValue [
    0 1 0 0,
    0 1 0 3.14159,
    0 1 0 6.28318
  ]
}

ROUTE t_ld.fraction_changed TO ld_rot.set_fraction
ROUTE ld_rot.value_changed TO leida.set_rotation
