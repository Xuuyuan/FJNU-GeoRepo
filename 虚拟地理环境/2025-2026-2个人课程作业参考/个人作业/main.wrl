#VRML V2.0 utf8

# 主文件：虚拟山谷水文观测站

WorldInfo {
  title "虚拟山谷水文观测站"
  info [
    "《虚拟地理环境》期末个人 VRML 作业"
    "主题：虚拟山谷水文观测站"
    "包含地形、水体、观测设备、文字标注、灯光、动画与交互"
  ]
}

NavigationInfo {
  type [ "EXAMINE", "WALK", "FLY" ]
  speed 2.0
  headlight FALSE
  avatarSize [ 0.25, 1.6, 0.75 ]
}

Viewpoint {
  description "View_All"
  position 0 7.2 17
  orientation 1 0 0 -0.38
  fieldOfView 0.90
}

Viewpoint {
  description "View_Station_Button"
  position 2.8 2.4 6.5
  orientation 1 0 0 -0.27
  fieldOfView 0.65
}

Viewpoint {
  description "View_River"
  position 0 3.0 8.3
  orientation 1 0 0 -0.30
  fieldOfView 0.66
}

Background {
  skyColor [
    0.03 0.10 0.22,
    0.18 0.42 0.70,
    0.63 0.82 1.00
  ]
  skyAngle [ 1.15, 1.57 ]
  groundColor [
    0.08 0.18 0.10,
    0.22 0.36 0.14,
    0.45 0.48 0.28
  ]
  groundAngle [ 1.20, 1.57 ]
}

DirectionalLight {
  direction -0.45 -0.8 -0.35
  color 1.0 0.93 0.78
  intensity 0.85
  ambientIntensity 0.22
}

PointLight {
  location 0 4 2
  radius 10
  color 0.55 0.73 1.0
  intensity 0.35
}

SpotLight {
  location 2.7 3.2 1.6
  direction -0.3 -1 -0.35
  color 1.0 0.88 0.56
  intensity 0.75
  beamWidth 0.55
  cutOffAngle 0.95
  radius 8
}

Group {
  children [
    # 地形、水文设备和天空动态分别放在子文件中，主文件用 Inline 组合。
    Inline { url [ "terrain.wrl" ] }
    Inline { url [ "station.wrl" ] }
    Inline { url [ "weather.wrl" ] }

    DEF biaoti Transform {
      translation 0 3.0 3.2
      children [
        Billboard {
          axisOfRotation 0 1 0
          children [
            Shape {
              appearance Appearance {
                material Material {
                  diffuseColor 1 1 1
                  emissiveColor 0.78 0.9 1
                }
              }
              geometry Text {
                string [ "虚拟山谷水文观测站" ]
                fontStyle FontStyle {
                  family "SANS"
                  style "BOLD"
                  justify [ "MIDDLE", "MIDDLE" ]
                  size 0.36
                }
              }
            }
          ]
        }
      ]
    }

    DEF btn_yj Transform {
      translation 3.8 1.45 3.0
      children [
        Transform {
          translation 0 -0.42 0
          children [
            Shape {
              appearance Appearance {
                material Material {
                  diffuseColor 0.12 0.12 0.12
                  specularColor 0.20 0.20 0.20
                }
              }
              geometry Cylinder { radius 0.13 height 0.85 }
            }
          ]
        }
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.16 0.16 0.16
              specularColor 0.25 0.25 0.25
            }
          }
          geometry Cylinder { radius 0.48 height 0.18 }
        }
        Transform {
          translation 0 0.13 0
          children [
            Shape {
              appearance Appearance {
                material DEF btn_mat Material {
                  diffuseColor 0.8 0.05 0.02
                  emissiveColor 0.35 0.02 0.01
                  specularColor 0.8 0.2 0.1
                  shininess 0.6
                }
              }
              geometry Cylinder { radius 0.34 height 0.14 }
            }
          ]
        }
        DEF btn_touch TouchSensor {
          description "点击启动山洪预警演示"
        }
        Transform {
          translation 0 0.66 0.28
          children [
            Billboard {
              axisOfRotation 0 1 0
              children [
                Shape {
                  appearance Appearance {
                    material Material {
                      diffuseColor 1 1 1
                      emissiveColor 0.78 0.88 1
                    }
                  }
                  geometry Text {
                    string [ "点击红色按钮" "触发山洪预警" ]
                    fontStyle FontStyle {
                      family "SANS"
                      justify [ "MIDDLE", "MIDDLE" ]
                      size 0.18
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    }

    DEF yj_pai Transform {
      translation -2.6 -1.15 3.55
      children [
        Billboard {
          axisOfRotation 0 1 0
          children [
            Shape {
              appearance Appearance {
                material Material {
                  diffuseColor 0.55 0.03 0.02
                  emissiveColor 0.12 0.01 0.01
                  transparency 0.08
                }
              }
              geometry Box { size 4.3 0.92 0.08 }
            }
            Transform {
              translation 0 0.06 0.08
              children [
                Shape {
                  appearance Appearance {
                    material Material {
                      diffuseColor 1 0.96 0.72
                      emissiveColor 1 0.35 0.08
                    }
                  }
                  geometry Text {
                    string [ "山洪预警：水位快速上涨" "请检查雨量计、雷达与河道监测点" ]
                    fontStyle FontStyle {
                      family "SANS"
                      style "BOLD"
                      justify [ "MIDDLE", "MIDDLE" ]
                      size 0.20
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    }

    DEF yanmo Transform {
      translation 0 0.42 0.45
      scale 0.01 0.01 0.01
      children [
        Shape {
          appearance Appearance {
            material DEF yanmo_mat Material {
              diffuseColor 0.72 0.16 0.04
              emissiveColor 0.20 0.03 0.01
              transparency 0.42
            }
          }
          geometry Box { size 3.9 0.045 6.8 }
        }
        Transform {
          translation 0 0.16 1.7
          children [
            Billboard {
              axisOfRotation 0 1 0
              children [
                Shape {
                  appearance Appearance {
                    material Material {
                      diffuseColor 1.0 0.96 0.72
                      emissiveColor 1.0 0.22 0.04
                    }
                  }
                  geometry Text {
                    string [ "临时淹没范围" ]
                    fontStyle FontStyle {
                      family "SANS"
                      style "BOLD"
                      justify [ "MIDDLE", "MIDDLE" ]
                      size 0.20
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    }

    DEF hf_wave Transform {
      translation 0 0.60 -4.4
      scale 0.01 0.01 0.01
      children [
        Shape {
          appearance Appearance {
            material DEF ni_shui_mat Material {
              diffuseColor 0.42 0.24 0.08
              emissiveColor 0.10 0.05 0.01
              specularColor 0.45 0.35 0.20
              shininess 0.35
              transparency 0.18
            }
          }
          geometry Box { size 2.25 0.36 1.70 }
        }
        Transform {
          translation 0 0.26 0.74
          children [
            Shape {
              appearance Appearance {
                material Material {
                  diffuseColor 0.58 0.34 0.12
                  emissiveColor 0.16 0.07 0.02
                  transparency 0.10
                }
              }
              geometry Box { size 2.36 0.64 0.18 }
            }
          ]
        }
        Transform {
          translation 0 0.48 0.82
          children [
            Shape {
              appearance Appearance {
                material Material {
                  diffuseColor 0.92 0.96 0.90
                  emissiveColor 0.24 0.25 0.20
                  transparency 0.24
                }
              }
              geometry Box { size 2.45 0.08 0.16 }
            }
          ]
        }
        Transform {
          translation 0 0.76 0.15
          children [
            Billboard {
              axisOfRotation 0 1 0
              children [
                Shape {
                  appearance Appearance {
                    material Material {
                      diffuseColor 1.0 0.96 0.74
                      emissiveColor 1.0 0.25 0.04
                    }
                  }
                  geometry Text {
                    string [ "浑浊洪峰向下游推进" ]
                    fontStyle FontStyle {
                      family "SANS"
                      style "BOLD"
                      justify [ "MIDDLE", "MIDDLE" ]
                      size 0.18
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    }

    DEF po_jt Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.18 0.70 1.0
          emissiveColor 0.04 0.20 0.34
          transparency 0.12
        }
      }
      geometry Cone { bottomRadius 0.16 height 0.90 }
    }

    DEF poL Transform {
      translation -3.2 1.0 -1.1
      rotation 0 0 1 -1.5708
      scale 0.01 0.01 0.01
      children [ USE po_jt ]
    }

    DEF poR Transform {
      translation 3.2 1.0 0.9
      rotation 0 0 1 1.5708
      scale 0.01 0.01 0.01
      children [ USE po_jt ]
    }

    DEF yj_light PointLight {
      location 0 1.9 1.7
      radius 8
      color 1.0 0.12 0.04
      intensity 0
    }
  ]
}

DEF t_yj TimeSensor {
  cycleInterval 8
  loop FALSE
}

DEF yj_move PositionInterpolator {
  key [ 0, 0.12, 0.88, 1 ]
  keyValue [
    -2.6 -1.15 3.55,
    -2.6 1.38 3.55,
    -2.6 1.38 3.55,
    -2.6 -1.15 3.55
  ]
}

DEF btn_flash ColorInterpolator {
  key [ 0, 0.12, 0.24, 0.36, 0.48, 0.60, 0.78, 1 ]
  keyValue [
    0.35 0.02 0.01,
    1.00 0.08 0.02,
    0.20 0.00 0.00,
    1.00 0.08 0.02,
    0.20 0.00 0.00,
    1.00 0.08 0.02,
    0.70 0.03 0.02,
    0.35 0.02 0.01
  ]
}

DEF hf_move PositionInterpolator {
  key [ 0, 0.10, 0.82, 1 ]
  keyValue [
    0 0.60 -4.4,
    0 0.66 -3.3,
    0 0.66 3.8,
    0 0.60 4.7
  ]
}

DEF hf_scale PositionInterpolator {
  key [ 0, 0.08, 0.82, 1 ]
  keyValue [
    0.01 0.01 0.01,
    1.00 1.00 1.00,
    1.00 1.00 1.00,
    0.01 0.01 0.01
  ]
}

DEF yanmo_scale PositionInterpolator {
  key [ 0, 0.18, 0.78, 1 ]
  keyValue [
    0.01 0.01 0.01,
    1.00 1.00 1.00,
    1.00 1.00 1.00,
    0.01 0.01 0.01
  ]
}

DEF poL_path PositionInterpolator {
  key [ 0, 0.16, 0.58, 1 ]
  keyValue [
    -3.2 1.00 -1.1,
    -2.4 0.85 -1.0,
    -0.9 0.48 -0.6,
    -3.2 1.00 -1.1
  ]
}

DEF poR_path PositionInterpolator {
  key [ 0, 0.16, 0.58, 1 ]
  keyValue [
    3.2 1.00 0.9,
    2.4 0.86 0.8,
    0.9 0.48 0.4,
    3.2 1.00 0.9
  ]
}

DEF po_show PositionInterpolator {
  key [ 0, 0.12, 0.72, 1 ]
  keyValue [
    0.01 0.01 0.01,
    1.00 1.00 1.00,
    1.00 1.00 1.00,
    0.01 0.01 0.01
  ]
}

DEF yj_light_flash ScalarInterpolator {
  key [ 0, 0.10, 0.20, 0.32, 0.44, 0.56, 0.70, 0.86, 1 ]
  keyValue [ 0, 1.0, 0.2, 1.0, 0.2, 1.0, 0.2, 0.8, 0 ]
}

ROUTE btn_touch.touchTime TO t_yj.startTime
ROUTE t_yj.fraction_changed TO yj_move.set_fraction
ROUTE yj_move.value_changed TO yj_pai.set_translation
ROUTE t_yj.fraction_changed TO btn_flash.set_fraction
ROUTE btn_flash.value_changed TO btn_mat.set_emissiveColor
ROUTE t_yj.fraction_changed TO hf_move.set_fraction
ROUTE hf_move.value_changed TO hf_wave.set_translation
ROUTE t_yj.fraction_changed TO hf_scale.set_fraction
ROUTE hf_scale.value_changed TO hf_wave.set_scale
ROUTE t_yj.fraction_changed TO yanmo_scale.set_fraction
ROUTE yanmo_scale.value_changed TO yanmo.set_scale
ROUTE t_yj.fraction_changed TO poL_path.set_fraction
ROUTE poL_path.value_changed TO poL.set_translation
ROUTE t_yj.fraction_changed TO poR_path.set_fraction
ROUTE poR_path.value_changed TO poR.set_translation
ROUTE t_yj.fraction_changed TO po_show.set_fraction
ROUTE po_show.value_changed TO poL.set_scale
ROUTE po_show.value_changed TO poR.set_scale
ROUTE t_yj.fraction_changed TO yj_light_flash.set_fraction
ROUTE yj_light_flash.value_changed TO yj_light.set_intensity
