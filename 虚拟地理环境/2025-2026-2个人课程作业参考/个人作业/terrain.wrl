#VRML V2.0 utf8

# 子文件：terrain.wrl

WorldInfo {
  title "地形、水体与植被子场景"
}

Group {
  children [
    Transform {
      translation -6 0 -6
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.28 0.48 0.20
              ambientIntensity 0.35
              specularColor 0.04 0.06 0.03
            }
          }
          geometry ElevationGrid {
            xDimension 9
            zDimension 9
            xSpacing 1.5
            zSpacing 1.5
            creaseAngle 0.85
            solid FALSE
            height [
              1.70 1.45 1.20 1.05 0.95 1.05 1.25 1.45 1.65,
              1.45 1.16 0.92 0.72 0.64 0.72 0.95 1.16 1.42,
              1.22 0.95 0.67 0.42 0.30 0.40 0.66 0.96 1.20,
              1.06 0.78 0.48 0.23 0.12 0.24 0.50 0.80 1.08,
              0.92 0.66 0.38 0.16 0.04 0.15 0.36 0.68 0.95,
              1.05 0.78 0.50 0.25 0.12 0.25 0.48 0.78 1.05,
              1.24 0.97 0.70 0.45 0.33 0.45 0.70 0.97 1.23,
              1.46 1.20 0.98 0.76 0.66 0.76 0.98 1.20 1.45,
              1.70 1.48 1.28 1.12 1.00 1.12 1.28 1.48 1.70
            ]
          }
        }
      ]
    }

    DEF shui Transform {
      translation 0 0.19 0
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.08 0.45 0.82
              emissiveColor 0.00 0.10 0.18
              specularColor 0.75 0.9 1.0
              shininess 0.8
              transparency 0.38
            }
          }
          geometry Box { size 1.35 0.045 9.7 }
        }
        Transform {
          translation 0 0.015 4.85
          children [
            Shape {
              appearance Appearance {
                material Material {
                  diffuseColor 0.08 0.48 0.90
                  emissiveColor 0.00 0.12 0.20
                  specularColor 0.80 0.95 1.0
                  shininess 0.8
                  transparency 0.34
                }
              }
              geometry Cylinder { radius 1.65 height 0.055 }
            }
          ]
        }
      ]
    }

    DEF liu_jt Transform {
      translation 0 0.34 -3.8
      rotation 1 0 0 1.5708
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.7 0.92 1.0
              emissiveColor 0.06 0.18 0.28
              transparency 0.12
            }
          }
          geometry Cone { bottomRadius 0.18 height 0.55 }
        }
      ]
    }

    DEF liu_jt2 Transform {
      translation 0 0.34 -1.0
      rotation 1 0 0 1.5708
      children [ USE liu_jt ]
    }

    DEF stone1 Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.38 0.35 0.30
          specularColor 0.05 0.05 0.04
        }
      }
      geometry Sphere { radius 0.18 }
    }

    Transform { translation -0.95 0.28 -2.8 children [ USE stone1 ] }
    Transform { translation 0.88 0.27 -2.1 scale 0.7 0.55 0.7 children [ USE stone1 ] }
    Transform { translation -1.05 0.26 0.7 scale 0.8 0.65 0.8 children [ USE stone1 ] }
    Transform { translation 0.95 0.28 1.2 scale 0.6 0.55 0.6 children [ USE stone1 ] }

    DEF shu Group {
      children [
        Shape {
          appearance Appearance {
            material Material { diffuseColor 0.38 0.20 0.08 }
          }
          geometry Cylinder { radius 0.07 height 0.62 }
        }
        Transform {
          translation 0 0.47 0
          children [
            Shape {
              appearance Appearance {
                material Material { diffuseColor 0.08 0.33 0.14 }
              }
              geometry Cone { bottomRadius 0.34 height 0.82 }
            }
          ]
        }
        Transform {
          translation 0 0.82 0
          children [
            Shape {
              appearance Appearance {
                material Material { diffuseColor 0.06 0.26 0.11 }
              }
              geometry Cone { bottomRadius 0.24 height 0.62 }
            }
          ]
        }
      ]
    }

    Transform { translation -4.8 0.92 -2.9 scale 1.0 1.0 1.0 children [ USE shu ] }
    Transform { translation -4.2 0.78 0.8 scale 0.85 0.85 0.85 children [ USE shu ] }
    Transform { translation -3.3 0.70 2.7 scale 0.75 0.75 0.75 children [ USE shu ] }
    Transform { translation 4.0 0.85 -2.4 scale 0.95 0.95 0.95 children [ USE shu ] }
    Transform { translation 4.9 0.95 1.6 scale 1.05 1.05 1.05 children [ USE shu ] }
    Transform { translation 3.2 0.72 3.1 scale 0.78 0.78 0.78 children [ USE shu ] }

    Transform {
      translation -1.3 0.55 4.75
      children [
        Billboard {
          axisOfRotation 0 1 0
          children [
            Shape {
              appearance Appearance {
                material Material {
                  diffuseColor 0.88 0.98 1
                  emissiveColor 0.18 0.34 0.40
                }
              }
              geometry Text {
                string [ "生态蓄水池" "水位随时间轻微升降" ]
                fontStyle FontStyle {
                  family "SANS"
                  justify [ "MIDDLE", "MIDDLE" ]
                  size 0.18
                }
              }
            }
          ]
        }
      ]
    }

    Transform {
      translation 1.1 0.46 -3.4
      children [
        Billboard {
          axisOfRotation 0 1 0
          children [
            Shape {
              appearance Appearance {
                material Material {
                  diffuseColor 0.88 0.98 1
                  emissiveColor 0.18 0.34 0.40
                }
              }
              geometry Text {
                string [ "山谷河道" "蓝色箭头表示水流方向" ]
                fontStyle FontStyle {
                  family "SANS"
                  justify [ "MIDDLE", "MIDDLE" ]
                  size 0.16
                }
              }
            }
          ]
        }
      ]
    }
  ]
}

DEF t_water TimeSensor {
  cycleInterval 6
  loop TRUE
}

DEF water_updn PositionInterpolator {
  key [ 0, 0.5, 1 ]
  keyValue [
    0 0.17 0,
    0 0.34 0,
    0 0.17 0
  ]
}

DEF t_liu TimeSensor {
  cycleInterval 4
  loop TRUE
}

DEF liu_path PositionInterpolator {
  key [ 0, 1 ]
  keyValue [
    0 0.34 -4.1,
    0 0.34 3.4
  ]
}

ROUTE t_water.fraction_changed TO water_updn.set_fraction
ROUTE water_updn.value_changed TO shui.set_translation
ROUTE t_liu.fraction_changed TO liu_path.set_fraction
ROUTE liu_path.value_changed TO liu_jt.set_translation
