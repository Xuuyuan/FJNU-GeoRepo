#VRML V2.0 utf8

# 子文件：weather.wrl

WorldInfo {
  title "天空、云与日照子场景"
}

Group {
  children [
    DEF sunA Transform {
      rotation 0 1 0 0
      children [
        Transform {
          translation -4.8 5.8 -4.6
          children [
            Shape {
              appearance Appearance {
                material Material {
                  diffuseColor 1.0 0.75 0.18
                  emissiveColor 1.0 0.55 0.05
                  specularColor 1.0 0.92 0.45
                  shininess 0.85
                }
              }
              geometry Sphere { radius 0.48 }
            }
            PointLight {
              location 0 0 0
              color 1.0 0.86 0.56
              intensity 0.55
              radius 9
            }
          ]
        }
      ]
    }

    DEF yun_all Transform {
      translation -5.2 4.3 1.8
      children [
        DEF yun1 Group {
          children [
            Shape {
              appearance Appearance {
                material Material {
                  diffuseColor 0.95 0.98 1.0
                  emissiveColor 0.10 0.13 0.15
                  transparency 0.18
                }
              }
              geometry Sphere { radius 0.42 }
            }
            Transform {
              translation 0.45 0.08 0.02
              scale 1.28 0.78 0.9
              children [
                Shape {
                  appearance Appearance {
                    material Material {
                      diffuseColor 0.96 0.98 1.0
                      emissiveColor 0.10 0.13 0.15
                      transparency 0.20
                    }
                  }
                  geometry Sphere { radius 0.38 }
                }
              ]
            }
            Transform {
              translation -0.42 -0.02 0.04
              scale 1.05 0.70 0.9
              children [
                Shape {
                  appearance Appearance {
                    material Material {
                      diffuseColor 0.93 0.97 1.0
                      emissiveColor 0.09 0.12 0.14
                      transparency 0.22
                    }
                  }
                  geometry Sphere { radius 0.34 }
                }
              ]
            }
          ]
        }
        Transform { translation 1.7 0.18 -0.7 scale 0.78 0.78 0.78 children [ USE yun1 ] }
        Transform { translation 3.3 -0.05 0.55 scale 0.92 0.92 0.92 children [ USE yun1 ] }
      ]
    }

    Transform {
      translation -4.2 3.75 2.0
      children [
        Billboard {
          axisOfRotation 0 1 0
          children [
            Shape {
              appearance Appearance {
                material Material {
                  diffuseColor 1 1 1
                  emissiveColor 0.70 0.86 1
                }
              }
              geometry Text {
                string [ "云团缓慢移动" ]
                fontStyle FontStyle {
                  family "SANS"
                  justify [ "MIDDLE", "MIDDLE" ]
                  size 0.16
                }
              }
            }
          ]
        }
      ]
    }
  ]
}

DEF t_yun TimeSensor {
  cycleInterval 12
  loop TRUE
}

DEF yun_path PositionInterpolator {
  key [ 0, 0.5, 1 ]
  keyValue [
    -5.2 4.3 1.8,
    2.2 4.55 1.4,
    -5.2 4.3 1.8
  ]
}

DEF t_sun TimeSensor {
  cycleInterval 18
  loop TRUE
}

DEF sun_rot OrientationInterpolator {
  key [ 0, 0.5, 1 ]
  keyValue [
    0 1 0 -0.30,
    0 1 0 0.35,
    0 1 0 -0.30
  ]
}

ROUTE t_yun.fraction_changed TO yun_path.set_fraction
ROUTE yun_path.value_changed TO yun_all.set_translation
ROUTE t_sun.fraction_changed TO sun_rot.set_fraction
ROUTE sun_rot.value_changed TO sunA.set_rotation
