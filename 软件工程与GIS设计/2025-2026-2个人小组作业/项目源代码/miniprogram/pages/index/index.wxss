page {
  height: 100%;
  background: #dbeafe;
}

.page {
  position: relative;
  height: 100vh;
  overflow: hidden;
}

.page::before {
  content: "";
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at top left, rgba(255, 255, 255, 0.45), transparent 38%),
    linear-gradient(180deg, rgba(15, 23, 42, 0.08), transparent 24%);
  z-index: 1;
  pointer-events: none;
}

.campus-map {
  width: 100%;
  height: 100%;
}

.hud {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  z-index: 3;
}

.top-panel {
  top: 32rpx;
  height: 132rpx;
  pointer-events: none;
}

.gps-chip {
  position: absolute;
  left: 0;
  top: 52rpx;
  transform: translateY(10px);
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 18rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #0f172a;
  font-size: 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.12);
  pointer-events: auto;
}

.gps-chip-weak {
  background: rgba(254, 242, 242, 0.96);
  color: #b91c1c;
}

.chip-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #22c55e;
}

.gps-chip-weak .chip-dot {
  background: #ef4444;
}

.top-link-actions {
  position: absolute;
  left: 0;
  top: 0;
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  gap: 8rpx;
  white-space: nowrap;
  pointer-events: auto;
}

.top-action-button {
  display: inline-flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 64rpx;
  margin: 0;
  padding: 0 14rpx;
  line-height: 1;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #0f172a;
  font-size: 24rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.12);
}

.history-button,
.gallery-button,
.achievement-button,
.dashboard-button,
.clear-data-button {
  width: 64rpx;
}

.clear-data-button {
  background: rgba(220, 38, 38, 0.94);
  color: #ffffff;
}

.map-mode-button {
  position: absolute;
  right: 0;
  top: 0;
  width: 56rpx;
  pointer-events: auto;
}

.map-mode-button-active {
  background: #0f766e;
  color: #ffffff;
}

.explore-panel-host {
  bottom: 28rpx;
}

.explore-panel-host-transition {
  transition: bottom 220ms ease;
}
