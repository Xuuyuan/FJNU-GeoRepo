page {
  min-height: 100%;
  background: linear-gradient(180deg, #f0fdfa 0%, #f8fafc 52%, #eff6ff 100%);
}

.quiz-page {
  min-height: 100vh;
  padding: 32rpx 24rpx 56rpx;
  box-sizing: border-box;
}

.quiz-card,
.question-card,
.status-card {
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 18rpx 46rpx rgba(15, 23, 42, 0.1);
}

.quiz-card {
  padding: 36rpx 32rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #0f766e, #1d4ed8);
}

.quiz-kicker {
  font-size: 22rpx;
  opacity: 0.82;
}

.quiz-title {
  margin-top: 16rpx;
  font-size: 50rpx;
  font-weight: 800;
}

.quiz-description {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.55;
}

.knowledge-card {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.14);
  font-size: 25rpx;
  line-height: 1.55;
}

.question-card,
.status-card {
  margin-top: 24rpx;
  padding: 30rpx 28rpx;
}

.question-title,
.status-title {
  font-size: 31rpx;
  font-weight: 800;
  color: #0f172a;
  line-height: 1.45;
}

.status-text {
  margin-top: 12rpx;
  color: #64748b;
  font-size: 25rpx;
}

.option-list {
  margin-top: 24rpx;
}

.option-button,
.submit-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  margin-top: 16rpx;
  line-height: 1.2;
  border-radius: 22rpx;
  font-size: 27rpx;
  font-weight: 700;
}

.option-button {
  justify-content: flex-start;
  background: #f8fafc;
  color: #0f172a;
  text-align: left;
  padding: 0 24rpx;
}

.option-button-selected {
  background: #ccfbf1;
  color: #0f766e;
}

.submit-button {
  margin-top: 30rpx;
  background: #0f766e;
  color: #ffffff;
}

.option-button::after,
.submit-button::after {
  border: 0;
}
