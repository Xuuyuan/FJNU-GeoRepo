page {
  min-height: 100%;
  background:
    radial-gradient(circle at 12% 0%, rgba(20, 184, 166, 0.28), transparent 30%),
    linear-gradient(180deg, #ecfeff 0%, #f8fafc 48%, #eef2ff 100%);
}

.history-page {
  min-height: 100vh;
  padding: 32rpx 24rpx 52rpx;
  box-sizing: border-box;
}

.hero-card,
.status-card,
.session-card,
.history-summary {
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 18rpx 46rpx rgba(15, 23, 42, 0.1);
}

.hero-card {
  padding: 36rpx 32rpx;
  color: #ffffff;
  background:
    linear-gradient(135deg, rgba(15, 118, 110, 0.96), rgba(30, 64, 175, 0.94));
}

.hero-kicker {
  display: inline-flex;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.hero-title {
  margin-top: 20rpx;
  font-size: 50rpx;
  font-weight: 800;
}

.hero-subtitle {
  margin-top: 12rpx;
  font-size: 25rpx;
  opacity: 0.9;
}

.status-card {
  margin-top: 22rpx;
  padding: 30rpx 28rpx;
}

.warning-card {
  background: linear-gradient(180deg, #fff7ed, #ffffff);
}

.status-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #0f172a;
}

.status-text {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: #475569;
}

.retry-button {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
  height: 76rpx;
  line-height: 1.2;
  border-radius: 999rpx;
  background: #0f766e;
  color: #ffffff;
  font-size: 26rpx;
}

.retry-button::after {
  border: 0;
}

.history-list {
  margin-top: 22rpx;
}

.history-summary {
  display: flex;
  justify-content: space-between;
  padding: 22rpx 24rpx;
  font-size: 25rpx;
  font-weight: 700;
  color: #0f172a;
}

.history-tabs {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}

.history-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 68rpx;
  line-height: 1.2;
  border-radius: 999rpx;
  background: #ffffff;
  color: #0f172a;
  font-size: 23rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.08);
}

.history-tab-active {
  background: #0f766e;
  color: #ffffff;
}

.history-tab::after {
  border: 0;
}

.session-card {
  margin-top: 18rpx;
  padding: 28rpx 24rpx;
}

.session-header {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
}

.session-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #0f172a;
}

.session-time {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #64748b;
}

.session-badge {
  align-self: flex-start;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #dcfce7;
  color: #166534;
  font-size: 22rpx;
  font-weight: 700;
}

.metric-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 22rpx;
}

.metric-item {
  padding: 18rpx 14rpx;
  border-radius: 22rpx;
  background: #f8fafc;
}

.metric-label {
  font-size: 21rpx;
  color: #64748b;
}

.metric-value {
  margin-top: 8rpx;
  font-size: 25rpx;
  font-weight: 800;
  color: #0f172a;
}

.session-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 20rpx;
}

.session-tag {
  padding: 10rpx 14rpx;
  border-radius: 999rpx;
  background: #e0f2fe;
  color: #075985;
  font-size: 22rpx;
}

.accent-tag {
  background: #fef3c7;
  color: #92400e;
}

.route-tag {
  background: #dcfce7;
  color: #166534;
}

.session-detail {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #64748b;
}
